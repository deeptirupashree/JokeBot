import requests

# Check for inappropriate words
def contains_blocked_words(user_input):
    blocked_words = ["hate", "stupid", "idiot"]
    return any(word in user_input.lower() for word in blocked_words)

# Fetch a joke from an API
def fetch_joke():
    try:
        response = requests.get("https://official-joke-api.appspot.com/random_joke")
        if response.status_code == 200:
            joke_data = response.json()
            return f"{joke_data['setup']} {joke_data['punchline']}"
        else:
            return "Hmm, I couldn't fetch a joke right now. Try again later!"
    except:
        return "Oops! Something went wrong trying to fetch a joke."

# Start chatbot
print("I'm here to tell you a joke and brighten your mood! Would you like to hear one? Type 'no' to exit.")

user_input = input("You: ")

if "no" in user_input.lower() or contains_blocked_words(user_input):
    print("Bot: Goodbye or let's keep it friendly!")
else:
    print(f"Bot: {fetch_joke()}")

    while True:
        more = input("Bot: Do you want to hear one more joke? (yes/no): ").strip().lower()

        if contains_blocked_words(more):
            print("Bot: Let’s keep it friendly. Exiting now!")
            break
        elif more == "yes":
            print(f"Bot: {fetch_joke()}")
        elif more == "no":
            print("Bot: Alright! Have a good one! Catch you later!")
            break
        else:
            print("Bot: I didn’t catch that. Please type 'yes' or 'no'.")
